# Copy to app/.env.local: Next.js in app/ reads that file, not this one.
# Required
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna
# Optional (defaults shown)
VISION_MODEL=
DECISIONS_MODEL=openai/gpt-6-luna-decisions
SCREENING_CONFIDENCE_THRESHOLD=0.8
ANALYSIS_ESCALATION=auto
POLICY_DIR=../docs/policies
CASE_TTL_MINUTES=120
